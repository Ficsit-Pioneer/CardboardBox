<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CardboardBox targets .NET Framework 4.8, which ships with every copy of
    Windows 10 (1903+) and Windows 11. The result is ONE small .exe that needs
    nothing else installed.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CardboardBox</AssemblyName>
    <RootNamespace>CardboardBox</RootNamespace>
    <ApplicationIcon>CardboardBox.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Product>CardboardBox</Product>
    <Description>CardboardBox - the simple Minecraft server box</Description>
    <Copyright>CardboardBox contributors</Copyright>
    <DebugType>embedded</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CardboardBox.ico" LogicalName="CardboardBox.ico" />
  </ItemGroup>

</Project>
